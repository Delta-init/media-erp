# ── Stage 1: dependency install ───────────────────────────────────────────────
FROM node:22-alpine AS deps

WORKDIR /app

# Alpine needs libc compat for some native Node modules
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./
# Clean install — exact versions from lockfile, no scripts
RUN npm ci --ignore-scripts

# ── Stage 2: Next.js build ────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Public API URL baked into the JS bundle at build time
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# ── Stage 3: minimal production runner ────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Non-root user
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# standalone output includes its own node_modules subset — no full install needed
COPY --from=builder /app/public                           ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static     ./.next/static

USER nextjs

EXPOSE 3000

# Healthcheck — lightweight HTTP check on root path
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e \
    "require('http').get('http://localhost:3000', r => \
     process.exit(r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"

# standalone server.js is generated by Next.js — no next start needed
CMD ["node", "server.js"]
