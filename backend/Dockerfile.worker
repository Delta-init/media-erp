# ── Celery worker image ────────────────────────────────────────────────────────
# Identical build stages to the main Dockerfile; only the CMD differs.
# On Railway: create a "worker" service and set dockerfilePath to Dockerfile.worker
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# ── dependency layer (cached separately) ─────────────────────────────────────
FROM base AS deps

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── runtime ───────────────────────────────────────────────────────────────────
FROM deps AS runtime

RUN addgroup --system appgroup \
 && adduser  --system --ingroup appgroup --no-create-home appuser

COPY --chown=appuser:appgroup . .

USER appuser

# Worker + Beat combined in one container to save a Railway service slot.
# Override CELERY_CONCURRENCY via Railway env var (default: 2).
ENV CELERY_CONCURRENCY=2

CMD celery -A app.tasks.celery_app worker \
    --loglevel=info \
    --concurrency=${CELERY_CONCURRENCY} \
    --queues=default \
    -B
